{
  "name": "family-school-communication-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Counselor-facing family-school communication preparation prototype",
  "scripts": {
    "prestart": "npm run build:web",
    "start": "node app/server.js",
    "prestart:mock": "npm run build:web",
    "start:mock": "node scripts/start-mock.js",
    "prestart:pilot-local": "npm run build:web",
    "start:pilot-local": "node scripts/start-pilot-local.js",
    "model:check": "node scripts/check-model.js",
    "eval:frozen": "node scripts/evaluate-frozen.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test tests/*.test.js",
    "test:web": "tsx --test apps/web/src/state.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
