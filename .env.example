# 家校沟通助手 本地配置（不要提交或分享这个文件）
# 主模型使用 DeepSeek 密钥。MOCK=1 为离线示例，MOCK=0 启用真实联调。
PORT=8787
MOCK=1
AI_PROVIDER=deepseek

# DeepSeek 官方 API key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
# Flash 和 V4 Pro 默认关闭思考，可显式填 true 或 false。
DEEPSEEK_ENABLE_THINKING=

# 千问（阿里云百炼 API key；不是订阅 Coding Plan 的通用替代）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max-0902
# 小批量质量对照可手动使用 qwen3.8-flash。
# 默认中国内地兼容接口；如账号使用其他地域，请按控制台修改。
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# Max 0902 和 3.8 Flash 默认关闭思考。其他模型留空使用服务方默认值。
QWEN_ENABLE_THINKING=

# 可选：用项目外密钥文件替代上面的 key 值（文件只含 key）。
QWEN_KEY_FILE=
KEY_FILE=

# 资料选取策略（一般不用改；改后需重启）。默认值见 app/config.js 的 SOURCE_DEFAULTS。
# SOURCE_TIERING=1        1 = 候选卡只在没有已审资料覆盖该步骤时出现；0 = 全部平铺
# MAX_SOURCES_PER_MOVE=8  每个沟通步骤最多给模型几个候选资料；0 = 不限（0–50）
# EXPOSE_APPLICATIONS=0   1 = 额外把卡片的「具体做法」发给模型；对照实验无收益，默认关
# 布尔项接受 1/0、true/false、yes/no、on/off，其他写法启动时直接报错。
